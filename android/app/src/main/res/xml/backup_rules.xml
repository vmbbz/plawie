<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower: Plawie runtime state contains provider credentials,
     Gateway bearer tokens, wallet metadata, and chat/session data. Recovery is
     explicit and user-driven; none of this state belongs in Auto Backup. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
